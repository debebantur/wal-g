+// SetUseOldestVersion controls whether ReadObject fetches the oldest available
+// version of an object instead of the current (latest) one. This is useful for
+// recovering backups when the latest version has been deleted or tampered with.
+func (folder *Folder) SetUseOldestVersion(use bool) {
+	tracelog.DebugLogger.Printf("setting use oldest version %t for folder %s", use, folder.path)
+	folder.config.useOldestVersion = use
+}
+
+// GetUseOldestVersion returns whether this folder is configured to read the
+// oldest available version of objects.
+func (folder *Folder) GetUseOldestVersion() bool {
+	return folder.config.useOldestVersion
+}
