+
+// readOldestObjectVersion lists all versions of the object and reads the oldest one.
+func (folder *Folder) readOldestObjectVersion(objectRelativePath string) (io.ReadCloser, error) {
+	objectPath := folder.path + objectRelativePath
+
+	var oldestVersion *versionInfo
+	input := &s3.ListObjectVersionsInput{
+		Bucket: folder.bucket,
+		Prefix: aws.String(objectPath),
+	}
+	err := folder.s3API.ListObjectVersionsPages(input, func(out *s3.ListObjectVersionsOutput, _ bool) bool {
+		for _, v := range out.Versions {
+			if *v.Key != objectPath {
+				continue
+			}
+			vi := &versionInfo{
+				relativePath: objectRelativePath,
+				lastModified: *v.LastModified,
+				size:         *v.Size,
+				versionID:    *v.VersionId,
+				isLatest:     *v.IsLatest,
+			}
+			if oldestVersion == nil || vi.lastModified.Before(oldestVersion.lastModified) {
+				oldestVersion = vi
+			}
+		}
+		return true
+	})
+	if err != nil {
+		return nil, errors.Wrapf(err, "failed to list versions for object '%s'", objectPath)
+	}
+	if oldestVersion == nil {
+		return nil, errors.Wrapf(ErrNoVersionsFound, "object '%s' has no versions in S3", objectPath)
+	}
+	tracelog.InfoLogger.Printf("Using oldest version %s (modified %s) for object '%s'",
+		oldestVersion.versionID, oldestVersion.lastModified.Format(time.RFC3339), objectPath)
+	return folder.readObjectWithVersion(objectRelativePath, oldestVersion.versionID)
+}
+
